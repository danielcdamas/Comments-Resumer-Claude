# Copie para .env (desenvolvimento local) ou cadastre em Vercel > Project > Settings > Environment Variables.
# Todas são opcionais: sem elas, cada usuário informa as próprias chaves na tela "Configurações".

# Chave da YouTube Data API v3 (Google Cloud Console).
YOUTUBE_API_KEY=

# Chave da API do Gemini (https://aistudio.google.com/apikey).
GEMINI_API_KEY=

# Modelo padrão do Gemini.
GEMINI_MODEL=gemini-3.8-flash

# Se definida, exige esta senha para usar as chaves acima (evita consumo da sua cota por terceiros).
APP_PASSWORD=
